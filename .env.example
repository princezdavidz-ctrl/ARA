NODE_ENV=development
PORT=3000
# Origins of separately deployed frontends (comma-separated if multiple environments).
ARA_CRM_ORIGIN=https://ara-company-crm.example.com
ARA_ADMIN_ORIGIN=https://ara-super-admin.example.com
DATABASE_URL=postgresql://ara:change-me@localhost:5432/ara
OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
INGESTION_API_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters

# Required only when a company stores channel credentials through /platform/channels.
# Generate with: openssl rand -hex 32. Keep this stable and store it in a secret manager.
ARA_CHANNEL_ENCRYPTION_KEY=
ARA_CHANNEL_ENCRYPTION_KEY_VERSION=v1

# Optional one-time bootstrap for the first ARA Super Admin account.
# Set before first startup AFTER applying migration 011. Use a unique 16+ character secret,
# store it in a secret manager, then remove it from the runtime environment after bootstrap.
ARA_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
ARA_BOOTSTRAP_PLATFORM_ADMIN_NAME=
ARA_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.28

# Optional inbound webhook. Configure all four together.
WHATSAPP_AGENCY_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional outbound Cloud API delivery. Leave blank to keep replies queued.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v27.0

# Optional email channel (Resend outbound API + ARA signed inbound webhook).
# Configure all four values together; otherwise leave them blank.
EMAIL_AGENCY_ID=
EMAIL_RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=

# Optional Instagram Messaging API (professional account + app review/permissions).
INSTAGRAM_AGENCY_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Optional TikTok Business Messaging API (approved app + authorized Business Account).
# TikTok access tokens expire; refresh/rotate them before expiry.
TIKTOK_AGENCY_ID=
TIKTOK_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_WEBHOOK_SECRET=

# Normalized payment callback relay. The upstream payment adapter must verify
# the provider-native callback, then HMAC-sign timestamp + "." + raw body for ARA.
BILLING_WEBHOOK_SECRET=

# Safaricom Daraja M-Pesa STK Push. Keep all values in the API secret manager, never in frontend config.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=
MPESA_CALLBACK_URL=https://api.example.com/webhooks/mpesa/stk
