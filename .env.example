# Email used for login and registration OTP verification (Gmail SMTP).
# Generate a Google App Password for the sender account and store it only in Render secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=princeinvents@gmail.com
SMTP_PASS=
ARA_AUTH_EMAIL_FROM=princeinvents@gmail.com

# Optional email channel (Resend outbound API + ARA signed inbound webhook).
# Configure all four values together; otherwise leave them blank.
EMAIL_AGENCY_ID=
EMAIL_RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=

# Optional authenticated Ollama fallback gateway. Store the token only in Render secrets.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=
LOCAL_LLM_CHAT_MODEL=qwen2.5:0.5b
LOCAL_LLM_TIMEOUT_MS=90000
