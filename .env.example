NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ara:change-me@localhost:5432/ara
OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
INGESTION_API_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.28

# Optional inbound webhook. Configure all four together.
WHATSAPP_AGENCY_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional outbound Cloud API delivery. Leave blank to keep replies queued.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
